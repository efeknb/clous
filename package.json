{
  "name": "clous",
  "version": "1.0.0",
  "description": "Advanced data processing automation and data loss prevention system. Provides WAL, checkpoint/rollback, circuit breaker, retry mechanisms, and .env configuration management.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "clean": "rimraf dist coverage"
  },
  "keywords": [
    "data-processing",
    "data-loss-prevention",
    "automation",
    "pipeline",
    "wal",
    "write-ahead-log",
    "checkpoint",
    "rollback",
    "circuit-breaker",
    "retry",
    "rate-limiter",
    "env",
    "config",
    "transfer",
    "data-integrity"
  ],
  "author": "efeka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/efeka/clous.git"
  },
  "bugs": {
    "url": "https://github.com/efeka/clous/issues"
  },
  "homepage": "https://github.com/efeka/clous#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
